[Unit]
Description=Card_PWA Production HTTPS Server
After=network.target

[Service]
Type=simple
User=_vb
Group=_vb
WorkingDirectory=/home/_vb/card_pwa_app/card_pwa
Environment=NODE_ENV=production
Environment=PWA_HOST=0.0.0.0
Environment=PWA_PORT=8444
Environment=PWA_CERT_FILE=.cert/prod-cert.pem
Environment=PWA_KEY_FILE=.cert/prod-key.pem
Environment=PWA_CA_FILE=.cert/rootCA.pem
Environment=PWA_LOG_DIR=logs
# Verzeichnis der selbst gehosteten Lernvideos (.mp4), ausgeliefert unter /media/messer/
# Wert MUSS gequotet werden — der Pfad enthaelt Leerzeichen, sonst zerlegt
# systemd ihn in mehrere ungueltige Environment-Tokens (nur das erste Wort
# vor dem ersten Leerzeichen wuerde als Wert ankommen).
Environment="PWA_MEDIA_DIR=/home/_vb/card_pwa_app/youtube-playlists/CompTIA SY0-701 Security+ Training Course [PLG49S3nxzAnl4QDVqK-hOnoqcSKEIDDuv]"
Environment=PWA_SYNC_PROXY_TARGET=https://127.0.0.1:8787
Environment=PWA_SYNC_PROXY_TLS_VERIFY=0
ExecStart=/usr/bin/node /home/_vb/card_pwa_app/card_pwa/scripts/prod-server.mjs
Restart=always
RestartSec=3

# Persist logs in project directory (systemd 249+ supports append:)
StandardOutput=append:/home/_vb/card_pwa_app/card_pwa/logs/systemd-stdout.log
StandardError=append:/home/_vb/card_pwa_app/card_pwa/logs/systemd-stderr.log

[Install]
WantedBy=multi-user.target

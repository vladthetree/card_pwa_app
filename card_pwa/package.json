{
  "name": "card-pwa",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "DEV_HTTPS=1 vite --host 0.0.0.0 --port 5173",
    "dev:https:setup": "./scripts/generate-dev-cert.sh",
    "build": "npm run check:security-visuals && tsc && vite build",
    "build:prod": "npm run build",
    "prod:cert:setup": "./scripts/setup-prod-cert.sh",
    "prod:start": "node ./scripts/prod-server.mjs",
    "prod:ufw:home": "./scripts/setup-ufw-home-only.sh",
    "preview": "vite preview",
    "test": "vitest",
    "check:safe-area": "node ./scripts/check-safe-area-legacy.mjs",
    "check:theme-contrast": "node ./scripts/check-theme-contrast.mjs",
    "check:security-visuals": "vitest run src/__tests__/components/security-visuals.test.tsx",
    "verify:phase5": "npm run check:safe-area && npm run check:architecture && npm run check:theme-contrast && npm run build && TZ=UTC vitest --run",
    "validate:cards": "node ./scripts/validate-cards.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check:architecture": "node ./scripts/check-architecture-imports.mjs",
    "e2e:study": "node ./scripts/e2e-study-back-smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@open-spaced-repetition/binding": "^0.5.0",
    "@open-spaced-repetition/binding-wasm32-wasi": "^0.5.0",
    "dexie": "^4.4.6",
    "framer-motion": "^13.2.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
